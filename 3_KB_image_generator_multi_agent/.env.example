# Environment Configuration for Brand-Aware AI Image Generator
# Copy this file to .env and fill in your actual values

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Customize image generation settings
# IMAGE_SIZE=1024x1024
# IMAGE_QUALITY=standard

# Optional: Brand-specific overrides
# DEFAULT_BRAND=acme
# LOGO_SIZE_RATIO=0.25
# LOGO_PADDING_RATIO=0.03

# Note: Make sure to set OPENAI_API_KEY before running the script
# export OPENAI_API_KEY=your_actual_key_here
